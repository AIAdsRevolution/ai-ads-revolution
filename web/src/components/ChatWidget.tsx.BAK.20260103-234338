"use client";
import React, { useEffect, useMemo, useRef, useState } from "react";

type Msg = { role: "assistant" | "user"; text: string };

export default function ChatWidget() {
  const [open, setOpen] = useState(false);
  const [input, setInput] = useState("");

  const [messages, setMessages] = useState<Msg[]>([
    { role: "assistant", text: "Ciao, sono **AAR Assistant** 🤖\nDisponibile 24 ore su 24 🚀" },
    { role: "assistant", text: "Per rispondere in modo personalizzato 💎 dimmi cosa vuoi fare:" },
  ]);

  const quickReplies = useMemo(
    () => ["Collegare Google Ads", "Ottimizzare Budget", "Creare Creatività", "Vedere KPI / ROAS"],
    []
  );

  const boxRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    if (!open) return;
    const t = setTimeout(() => {
      boxRef.current?.scrollTo({ top: boxRef.current.scrollHeight, behavior: "smooth" });
    }, 30);
    return () => clearTimeout(t);
  }, [open, messages]);

  const ui = useMemo(() => {
    // AAR palette (Meta-like premium)
    const bg = "rgba(10, 12, 18, 0.92)";
    const card = "rgba(255,255,255,0.06)";
    const border = "rgba(255,255,255,0.12)";
    const text = "rgba(255,255,255,0.92)";
    const sub = "rgba(255,255,255,0.70)";
    const blue = "#2D6CFF";
    const violet = "#7B61FF";
    const cyan = "#3EF3FF";
    const dark = "rgba(12,14,20,0.88)";
    return { bg, card, border, text, sub, blue, violet, cyan, dark };
  }, []);

  // Avatar “premium” (più bello e leggibile) + glow interno
  const avatar = useMemo(() => {
    const svg =
      `<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'>
        <defs>
          <radialGradient id='rg' cx='30%' cy='25%' r='70%'>
            <stop offset='0' stop-color='${ui.cyan}' stop-opacity='0.95'/>
            <stop offset='0.55' stop-color='${ui.violet}' stop-opacity='0.90'/>
            <stop offset='1' stop-color='${ui.blue}' stop-opacity='0.90'/>
          </radialGradient>
          <filter id='soft' x='-20%' y='-20%' width='140%' height='140%'>
            <feGaussianBlur stdDeviation='2.2' result='b'/>
            <feMerge>
              <feMergeNode in='b'/>
              <feMergeNode in='SourceGraphic'/>
            </feMerge>
          </filter>
        </defs>

        <!-- outer glow -->
        <circle cx='60' cy='60' r='54' fill='url(#rg)' opacity='0.30' filter='url(#soft)'/>
        <circle cx='60' cy='60' r='46' fill='rgba(0,0,0,0.30)' stroke='rgba(255,255,255,0.20)' stroke-width='2'/>

        <!-- face disk -->
        <circle cx='60' cy='60' r='34' fill='rgba(255,255,255,0.94)'/>
        <circle cx='60' cy='60' r='34' fill='none' stroke='rgba(0,0,0,0.08)' stroke-width='1'/>

        <!-- eyes -->
        <circle cx='48' cy='56' r='4.3' fill='#0B0F1A'/>
        <circle cx='72' cy='56' r='4.3' fill='#0B0F1A'/>

        <!-- smile -->
        <path d='M46 74c6 7 22 7 28 0' fill='none' stroke='#0B0F1A' stroke-width='4' stroke-linecap='round'/>

        <!-- small highlight -->
        <circle cx='46' cy='48' r='6' fill='rgba(255,255,255,0.55)'/>
      </svg>`;
    return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
  }, [ui.blue, ui.violet, ui.cyan]);

  function addUserAndReply(text: string) {
    const t = text.trim();
    if (!t) return;

    setMessages((m) => [...m, { role: "user", text: t }]);

    const low = t.toLowerCase();
    const reply =
      low.includes("google") || low.includes("ads")
        ? "✅ Collegamento Google Ads: Developer Token + OAuth + Refresh Token.\nVuoi farlo ora? (ti guido step-by-step)"
        : low.includes("budget")
        ? "💰 Budget: dimmi **obiettivo** (lead/vendite) + **budget giornaliero**.\nTi preparo regole ROAS/CPA per spostamento automatico."
        : low.includes("creativ")
        ? "🎨 Creatività: dimmi **settore + offerta + target**.\nTi preparo 5 varianti annuncio + 5 hook pronti."
        : low.includes("kpi") || low.includes("roas")
        ? "📊 KPI: appena colleghiamo Google Ads posso leggere ROAS/CTR/CPC reali e mostrarti trend e alert."
        : "Ok ✅ dimmi cosa vuoi ottimizzare (CPC, CPA, ROAS) e su quale campagna.";

    setTimeout(() => setMessages((m) => [...m, { role: "assistant", text: reply }]), 220);
  }

  function send() {
    const t = input.trim();
    if (!t) return;
    setInput("");
    addUserAndReply(t);
  }

  const ringAnim = `
    @keyframes aarRing { 
      0%{ transform: rotate(0deg) } 
      100%{ transform: rotate(360deg) } 
    }
    @keyframes aarFloat {
      0%,100%{ transform: translateY(0px) }
      50%{ transform: translateY(-2px) }
    }
  `;

  // Launcher “premium” (più bello e chiaro)
  const Launcher = (
    <>
      <style>{ringAnim}</style>
      <button
        onClick={() => setOpen(true)}
        aria-label="Apri assistente"
        style={{
          position: "fixed",
          right: 22,
          bottom: 22,
          width: 74,
          height: 74,
          borderRadius: 999,
          border: `1px solid ${ui.border}`,
          background: "transparent",
          padding: 0,
          cursor: "pointer",
          zIndex: 99999,
          boxShadow: "0 18px 58px rgba(0,0,0,0.65)",
          animation: "aarFloat 2.8s ease-in-out infinite",
        }}
      >
        {/* rotating ring */}
        <div
          style={{
            position: "absolute",
            inset: 0,
            borderRadius: 999,
            background: `conic-gradient(from 220deg, ${ui.cyan}, ${ui.violet}, ${ui.blue}, ${ui.cyan})`,
            opacity: 0.95,
            filter: "drop-shadow(0 0 10px rgba(62,243,255,0.15))",
            animation: "aarRing 5.5s linear infinite",
          }}
        />
        {/* inner body */}
        <div
          style={{
            position: "absolute",
            inset: 8,
            borderRadius: 999,
            background: ui.dark,
            border: `1px solid ${ui.border}`,
            display: "grid",
            placeItems: "center",
            backdropFilter: "blur(12px)",
          }}
        >
          <img src={avatar} alt="AAR assistant" style={{ width: 54, height: 54, borderRadius: 999 }} />
        </div>
      </button>
    </>
  );

  const Panel = (
    <div
      style={{
        position: "fixed",
        right: 18,
        bottom: 18,
        width: 460,
        maxWidth: "calc(100vw - 36px)",
        height: 640,
        maxHeight: "calc(100vh - 36px)",
        background: ui.bg,
        border: `1px solid ${ui.border}`,
        borderRadius: 18,
        zIndex: 99999,
        overflow: "hidden",
        boxShadow: "0 26px 100px rgba(0,0,0,0.72)",
        backdropFilter: "blur(16px)",
      }}
    >
      {/* TOP BAR */}
      <div
        style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          padding: "12px 14px",
          borderBottom: `1px solid ${ui.border}`,
          background: "rgba(255,255,255,0.03)",
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <div
            style={{
              width: 44,
              height: 44,
              borderRadius: 999,
              background: `conic-gradient(from 210deg, ${ui.cyan}, ${ui.violet}, ${ui.blue}, ${ui.cyan})`,
              padding: 2,
              display: "grid",
              placeItems: "center",
              boxShadow: "0 0 18px rgba(62,243,255,0.10)",
            }}
          >
            <div
              style={{
                width: "100%",
                height: "100%",
                borderRadius: 999,
                background: ui.dark,
                border: `1px solid ${ui.border}`,
                display: "grid",
                placeItems: "center",
              }}
            >
              <img src={avatar} alt="assistant" style={{ width: 36, height: 36, borderRadius: 999 }} />
            </div>
          </div>

          <div>
            <div style={{ color: ui.text, fontWeight: 950, lineHeight: 1.1 }}>
              Assistente Virtuale – AAR
            </div>
            <div style={{ color: ui.sub, fontSize: 12 }}>
              Disponibile 24 ore su 24 🚀
            </div>
          </div>
        </div>

        <button
          onClick={() => setOpen(false)}
          aria-label="Chiudi"
          style={{
            width: 36,
            height: 36,
            borderRadius: 12,
            border: `1px solid ${ui.border}`,
            background: "rgba(255,255,255,0.03)",
            color: ui.text,
            cursor: "pointer",
            fontSize: 16,
          }}
        >
          ✕
        </button>
      </div>

      {/* PRIVACY NOTE */}
      <div
        style={{
          padding: "10px 14px",
          borderBottom: `1px solid ${ui.border}`,
          color: ui.sub,
          fontSize: 12,
          lineHeight: 1.35,
          background: "rgba(255,255,255,0.02)",
        }}
      >
        Ricorda che i tuoi dati saranno trattati secondo l’informativa privacy.
      </div>

      {/* MESSAGES */}
      <div
        ref={boxRef}
        style={{
          padding: 14,
          height: 410,
          overflowY: "auto",
          display: "flex",
          flexDirection: "column",
          gap: 10,
        }}
      >
        {messages.map((m, i) => {
          const isUser = m.role === "user";
          return (
            <div
              key={i}
              style={{
                alignSelf: isUser ? "flex-end" : "flex-start",
                maxWidth: "86%",
                padding: "10px 12px",
                borderRadius: 14,
                whiteSpace: "pre-wrap",
                color: ui.text,
                background: isUser ? `linear-gradient(135deg, ${ui.blue}, ${ui.violet})` : ui.card,
                border: isUser ? "none" : `1px solid ${ui.border}`,
              }}
            >
              {m.text.replace(/\*\*(.*?)\*\*/g, "$1")}
            </div>
          );
        })}

        {/* QUICK BUTTONS */}
        <div style={{ display: "flex", flexWrap: "wrap", gap: 10, marginTop: 4 }}>
          {quickReplies.map((q) => (
            <button
              key={q}
              onClick={() => addUserAndReply(q)}
              style={{
                border: `1px solid ${ui.border}`,
                background: "rgba(255,255,255,0.03)",
                color: ui.text,
                padding: "10px 12px",
                borderRadius: 14,
                cursor: "pointer",
                fontWeight: 850,
              }}
            >
              {q}
            </button>
          ))}
        </div>
      </div>

      {/* INPUT */}
      <div
        style={{
          padding: 14,
          borderTop: `1px solid ${ui.border}`,
          display: "flex",
          gap: 10,
          background: "rgba(255,255,255,0.02)",
        }}
      >
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "Enter") send();
          }}
          placeholder="Scrivi qui il tuo messaggio…"
          style={{
            flex: 1,
            padding: "12px 12px",
            borderRadius: 14,
            border: `1px solid ${ui.border}`,
            background: "rgba(0,0,0,0.25)",
            color: ui.text,
            outline: "none",
          }}
        />
        <button
          onClick={send}
          style={{
            padding: "12px 16px",
            borderRadius: 14,
            border: `1px solid ${ui.border}`,
            background: `linear-gradient(135deg, ${ui.blue}, ${ui.violet})`,
            color: "white",
            fontWeight: 950,
            cursor: "pointer",
          }}
        >
          Invia
        </button>
      </div>
    </div>
  );

  return (
    <>
      {!open && Launcher}
      {open && Panel}
    </>
  );
}
