"use client";
import React, { useEffect, useMemo, useRef, useState } from "react";

type Msg = { role: "assistant" | "user"; text: string };

export default function ChatWidget() {
  const [open, setOpen] = useState(false);
  const [input, setInput] = useState("");

  const [messages, setMessages] = useState<Msg[]>([
    { role: "assistant", text: "Ciao, sono **AAR Assistant** 🤖\nDisponibile 24 ore su 24 🚀" },
    {
      role: "assistant",
      text:
        "Per rispondere in modo personalizzato 💎 dimmi cosa vuoi fare:",
    },
  ]);

  const quickReplies = useMemo(
    () => [
      "Collegare Google Ads",
      "Ottimizzare Budget",
      "Creare Creatività",
      "Vedere KPI / ROAS",
    ],
    []
  );

  const boxRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    if (!open) return;
    const t = setTimeout(() => {
      boxRef.current?.scrollTo({ top: boxRef.current.scrollHeight, behavior: "smooth" });
    }, 30);
    return () => clearTimeout(t);
  }, [open, messages]);

  const ui = useMemo(() => {
    // Palette AAR (Meta-like, ma proprietaria)
    const bg = "rgba(10, 12, 18, 0.90)";
    const card = "rgba(255,255,255,0.06)";
    const border = "rgba(255,255,255,0.12)";
    const text = "rgba(255,255,255,0.92)";
    const sub = "rgba(255,255,255,0.70)";
    const blue = "#2D6CFF";
    const violet = "#7B61FF";
    const cyan = "#3EF3FF";
    const dark = "rgba(12,14,20,0.88)";
    return { bg, card, border, text, sub, blue, violet, cyan, dark };
  }, []);

  const avatar = useMemo(() => {
    const svg =
      `<svg xmlns='http://www.w3.org/2000/svg' width='72' height='72' viewBox='0 0 72 72'>
        <defs>
          <linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
            <stop offset='0' stop-color='${ui.cyan}'/>
            <stop offset='0.55' stop-color='${ui.violet}'/>
            <stop offset='1' stop-color='${ui.blue}'/>
          </linearGradient>
        </defs>
        <circle cx='36' cy='36' r='33' fill='url(#g)' opacity='0.25'/>
        <circle cx='36' cy='36' r='24' fill='white' opacity='0.94'/>
        <circle cx='28' cy='34' r='3.4' fill='#121722'/>
        <circle cx='44' cy='34' r='3.4' fill='#121722'/>
        <path d='M27 46c4.2 4.5 16.8 4.5 21 0' fill='none' stroke='#121722' stroke-width='3' stroke-linecap='round'/>
      </svg>`;
    return "data:image/svg+xml;utf8," + encodeURIComponent(svg);
  }, [ui.blue, ui.violet, ui.cyan]);

  function addUserAndReply(text: string) {
    const t = text.trim();
    if (!t) return;

    setMessages((m) => [...m, { role: "user", text: t }]);

    const low = t.toLowerCase();

    const reply =
      low.includes("google") || low.includes("ads")
        ? "✅ Collegamento Google Ads: Developer Token + OAuth + Refresh Token.\nVuoi farlo ora? (ti guido step-by-step)"
        : low.includes("budget")
        ? "💰 Budget: dimmi **obiettivo** (lead/vendite) + **budget giornaliero**.\nTi preparo regole ROAS/CPA per spostamento automatico."
        : low.includes("creativ")
        ? "🎨 Creatività: dimmi **settore + offerta + target**.\nTi preparo 5 varianti annuncio + 5 hook pronti."
        : low.includes("kpi") || low.includes("roas")
        ? "📊 KPI: appena colleghiamo Google Ads posso leggere ROAS/CTR/CPC reali e mostrarti trend e alert."
        : "Ok ✅ dimmi esattamente cosa vuoi ottimizzare (CPC, CPA, ROAS) e su quale campagna.";

    setTimeout(() => setMessages((m) => [...m, { role: "assistant", text: reply }]), 220);
  }

  function send() {
    const t = input.trim();
    if (!t) return;
    setInput("");
    addUserAndReply(t);
  }

  // “launcher” stile Sky: faccina + ring
  const Launcher = (
    <button
      onClick={() => setOpen(true)}
      aria-label="Apri assistente"
      style={{
        position: "fixed",
        right: 22,
        bottom: 22,
        width: 72,
        height: 72,
        borderRadius: 999,
        border: `1px solid ${ui.border}`,
        background: "transparent",
        padding: 0,
        cursor: "pointer",
        zIndex: 99999,
        boxShadow: "0 18px 55px rgba(0,0,0,0.60)",
      }}
    >
      <div
        style={{
          position: "absolute",
          inset: 0,
          borderRadius: 999,
          background: `conic-gradient(from 220deg, ${ui.cyan}, ${ui.violet}, ${ui.blue}, ${ui.cyan})`,
          opacity: 0.95,
        }}
      />
      <div
        style={{
          position: "absolute",
          inset: 7,
          borderRadius: 999,
          background: ui.dark,
          border: `1px solid ${ui.border}`,
          display: "grid",
          placeItems: "center",
          backdropFilter: "blur(12px)",
        }}
      >
        <img src={avatar} alt="AAR assistant" style={{ width: 54, height: 54, borderRadius: 999 }} />
      </div>
    </button>
  );

  const Panel = (
    <div
      style={{
        position: "fixed",
        right: 18,
        bottom: 18,
        width: 440,
        maxWidth: "calc(100vw - 36px)",
        height: 610,
        maxHeight: "calc(100vh - 36px)",
        background: ui.bg,
        border: `1px solid ${ui.border}`,
        borderRadius: 18,
        zIndex: 99999,
        overflow: "hidden",
        boxShadow: "0 26px 95px rgba(0,0,0,0.70)",
        backdropFilter: "blur(16px)",
      }}
    >
      {/* TOP BAR */}
      <div
        style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          padding: "12px 14px",
          borderBottom: `1px solid ${ui.border}`,
          background: "rgba(255,255,255,0.03)",
        }}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <div
            style={{
              width: 42,
              height: 42,
              borderRadius: 999,
              background: `conic-gradient(from 210deg, ${ui.cyan}, ${ui.violet}, ${ui.blue}, ${ui.cyan})`,
              padding: 2,
              display: "grid",
              placeItems: "center",
            }}
          >
            <div
              style={{
                width: "100%",
                height: "100%",
                borderRadius: 999,
                background: ui.dark,
                border: `1px solid ${ui.border}`,
                display: "grid",
                placeItems: "center",
              }}
            >
              <img src={avatar} alt="assistant" style={{ width: 34, height: 34, borderRadius: 999 }} />
            </div>
          </div>

          <div>
            <div style={{ color: ui.text, fontWeight: 900, lineHeight: 1.1 }}>
              Assistente Virtuale – AAR
            </div>
            <div style={{ color: ui.sub, fontSize: 12 }}>
              Disponibile 24 ore su 24 🚀
            </div>
          </div>
        </div>

        <button
          onClick={() => setOpen(false)}
          aria-label="Chiudi"
          style={{
            width: 36,
            height: 36,
            borderRadius: 12,
            border: `1px solid ${ui.border}`,
            background: "transparent",
            color: ui.text,
            cursor: "pointer",
            fontSize: 16,
          }}
        >
          ✕
        </button>
      </div>

      {/* PRIVACY NOTE */}
      <div
        style={{
          padding: "10px 14px",
          borderBottom: `1px solid ${ui.border}`,
          color: ui.sub,
          fontSize: 12,
          lineHeight: 1.35,
          background: "rgba(255,255,255,0.02)",
        }}
      >
        Ricorda che i tuoi dati saranno trattati secondo l’informativa privacy.
      </div>

      {/* MESSAGES */}
      <div
        ref={boxRef}
        style={{
          padding: 14,
          height: 380,
          overflowY: "auto",
          display: "flex",
          flexDirection: "column",
          gap: 10,
        }}
      >
        {messages.map((m, i) => {
          const isUser = m.role === "user";
          return (
            <div
              key={i}
              style={{
                alignSelf: isUser ? "flex-end" : "flex-start",
                maxWidth: "86%",
                padding: "10px 12px",
                borderRadius: 14,
                whiteSpace: "pre-wrap",
                color: ui.text,
                background: isUser ? `linear-gradient(135deg, ${ui.blue}, ${ui.violet})` : ui.card,
                border: isUser ? "none" : `1px solid ${ui.border}`,
              }}
            >
              {m.text.replace(/\*\*(.*?)\*\*/g, "$1")}
            </div>
          );
        })}

        {/* QUICK BUTTONS (stile Sky: bottoni sotto) */}
        <div style={{ display: "flex", flexWrap: "wrap", gap: 10, marginTop: 4 }}>
          {quickReplies.map((q) => (
            <button
              key={q}
              onClick={() => addUserAndReply(q)}
              style={{
                border: `1px solid ${ui.border}`,
                background: "rgba(255,255,255,0.03)",
                color: ui.text,
                padding: "10px 12px",
                borderRadius: 14,
                cursor: "pointer",
                fontWeight: 800,
              }}
            >
              {q}
            </button>
          ))}
        </div>
      </div>

      {/* INPUT */}
      <div
        style={{
          padding: 14,
          borderTop: `1px solid ${ui.border}`,
          display: "flex",
          gap: 10,
          background: "rgba(255,255,255,0.02)",
        }}
      >
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === "Enter") send();
          }}
          placeholder="Scrivi qui il tuo messaggio…"
          style={{
            flex: 1,
            padding: "12px 12px",
            borderRadius: 14,
            border: `1px solid ${ui.border}`,
            background: "rgba(0,0,0,0.25)",
            color: ui.text,
            outline: "none",
          }}
        />
        <button
          onClick={send}
          style={{
            padding: "12px 16px",
            borderRadius: 14,
            border: `1px solid ${ui.border}`,
            background: `linear-gradient(135deg, ${ui.blue}, ${ui.violet})`,
            color: "white",
            fontWeight: 950,
            cursor: "pointer",
          }}
        >
          Invia
        </button>
      </div>
    </div>
  );

  return (
    <>
      {!open && Launcher}
      {open && Panel}
    </>
  );
}
