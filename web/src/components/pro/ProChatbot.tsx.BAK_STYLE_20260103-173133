"use client";

import React, { useEffect, useMemo, useRef, useState } from "react";

type Msg = { role: "user" | "assistant"; content: string };

export default function ProChatbot() {
  const [open, setOpen] = useState(false);
  const [busy, setBusy] = useState(false);
  const [input, setInput] = useState("");
  const [messages, setMessages] = useState<Msg[]>([
    {
      role: "assistant",
      content:
        "PRO Assistant attivo. Dimmi: piattaforma (Meta/Google), obiettivo, budget, paese e pubblico — e ti preparo strategia + copy + KPI.",
    },
  ]);

  const inputRef = useRef<HTMLInputElement | null>(null);
  const canSend = useMemo(() => input.trim().length > 0 && !busy, [input, busy]);

  useEffect(() => {
    const onToggle = () => setOpen((v) => !v);
    const onOpen = () => setOpen(true);
    const onClose = () => setOpen(false);

    window.addEventListener("proassistant:toggle", onToggle as any);
    window.addEventListener("proassistant:open", onOpen as any);
    window.addEventListener("proassistant:close", onClose as any);

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen(false);
    };
    window.addEventListener("keydown", onKeyDown);

    return () => {
      window.removeEventListener("proassistant:toggle", onToggle as any);
      window.removeEventListener("proassistant:open", onOpen as any);
      window.removeEventListener("proassistant:close", onClose as any);
      window.removeEventListener("keydown", onKeyDown);
    };
  }, []);

  useEffect(() => {
    if (open) setTimeout(() => inputRef.current?.focus(), 120);
  }, [open]);

  async function send() {
    const text = input.trim();
    if (!text || busy) return;

    setInput("");
    setBusy(true);
    setMessages((m) => [...m, { role: "user", content: text }]);

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: text }),
      });

      if (!res.ok) {
        const t = await res.text().catch(() => "");
        throw new Error(t || "Errore risposta server");
      }

      const data = await res.json().catch(() => null);
      const reply =
        data?.reply ||
        data?.message ||
        data?.output ||
        "Ok. Dimmi anche: KPI target, creatività (immagine/video) e landing.";

      setMessages((m) => [...m, { role: "assistant", content: String(reply) }]);
    } catch {
      setMessages((m) => [
        ...m,
        {
          role: "assistant",
          content:
            "⚠️ Non riesco a rispondere ora. Verifica /api/chat e le ENV. Intanto dimmi settore + obiettivo e ti guido step-by-step.",
        },
      ]);
    } finally {
      setBusy(false);
      setTimeout(() => inputRef.current?.focus(), 60);
    }
  }

  return (
    <>
      {/* ORB PRO (come stamattina: piccolo, pulito, potente) */}
      <button
        type="button"
        aria-label="Apri PRO Assistant"
        onClick={() => setOpen(true)}
        className="fixed bottom-6 right-6 z-[9999] grid h-14 w-14 place-items-center rounded-full text-white"
        style={{
          background:
            "radial-gradient(120% 120% at 30% 30%, rgba(56,189,248,0.95) 0%, rgba(99,102,241,0.55) 45%, rgba(2,6,23,0.30) 100%)",
          boxShadow:
            "0 0 0 1px rgba(255,255,255,0.10), 0 18px 60px rgba(0,0,0,0.55), 0 0 40px rgba(56,189,248,0.25)",
          backdropFilter: "blur(10px)",
        }}
      >
        <div
          className="grid h-12 w-12 place-items-center rounded-full"
          style={{
            boxShadow:
              "inset 0 0 0 1px rgba(255,255,255,0.12), 0 0 26px rgba(56,189,248,0.28)",
            background: "rgba(255,255,255,0.06)",
          }}
        >
          <span className="text-sm font-extrabold tracking-wide">AI</span>
        </div>

        {/* badge PRO piccolo */}
        <span
          className="absolute -right-1 -top-1 rounded-full px-2 py-0.5 text-[10px] font-extrabold"
          style={{
            background: "rgba(16,185,129,0.18)",
            color: "rgba(167,243,208,1)",
            boxShadow: "0 0 0 1px rgba(16,185,129,0.22)",
          }}
        >
          PRO
        </span>
      </button>

      {/* Drawer */}
      {open && (
        <div className="fixed inset-0 z-[9998]">
          <div
            className="absolute inset-0 bg-black/60"
            onClick={() => setOpen(false)}
          />
          <div
            className="absolute right-0 top-0 h-full w-[420px] max-w-[92vw] border-l border-white/10 bg-slate-950/88 text-white backdrop-blur-xl"
            style={{
              boxShadow:
                "0 0 0 1px rgba(255,255,255,0.06), -30px 0 90px rgba(0,0,0,0.65), 0 0 60px rgba(56,189,248,0.10)",
            }}
          >
            <div className="flex items-center justify-between border-b border-white/10 px-4 py-3">
              <div className="flex items-center gap-2">
                <div
                  className="h-2.5 w-2.5 rounded-full"
                  style={{
                    background: "rgba(56,189,248,0.85)",
                    boxShadow: "0 0 18px rgba(56,189,248,0.40)",
                  }}
                />
                <div className="text-sm font-semibold">
                  PRO Assistant — Neural Sky
                </div>
              </div>
              <button
                onClick={() => setOpen(false)}
                className="rounded-lg bg-white/5 px-2 py-1 text-xs hover:bg-white/10"
              >
                Chiudi
              </button>
            </div>

            <div className="flex h-[calc(100%-120px)] flex-col">
              <div className="flex-1 overflow-auto px-4 py-3">
                <div className="space-y-3">
                  {messages.map((m, i) => (
                    <div
                      key={i}
                      className={[
                        "max-w-[92%] rounded-2xl px-3 py-2 text-sm leading-relaxed",
                        m.role === "user"
                          ? "ml-auto bg-sky-500/15 ring-1 ring-sky-400/20"
                          : "mr-auto bg-white/5 ring-1 ring-white/10",
                      ].join(" ")}
                    >
                      {m.content}
                    </div>
                  ))}
                  {busy && (
                    <div className="mr-auto max-w-[92%] rounded-2xl bg-white/5 px-3 py-2 text-sm ring-1 ring-white/10">
                      Elaborazione neurale…
                    </div>
                  )}
                </div>
              </div>

              <div className="border-t border-white/10 p-3">
                <div className="flex items-center gap-2">
                  <input
                    ref={inputRef}
                    value={input}
                    onChange={(e) => setInput(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === "Enter") send();
                    }}
                    placeholder="Es: Meta Lead 20€/giorno Italia settore auto…"
                    className="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm outline-none placeholder:text-white/40 focus:border-white/20"
                  />
                  <button
                    onClick={send}
                    disabled={!canSend}
                    className="rounded-xl bg-sky-500/80 px-3 py-2 text-sm font-semibold text-white ring-1 ring-sky-300/20 transition hover:bg-sky-500 disabled:opacity-40"
                    style={{ boxShadow: "0 0 26px rgba(56,189,248,0.18)" }}
                  >
                    Invia
                  </button>
                </div>
                <div className="mt-2 flex items-center justify-between text-[11px] opacity-70">
                  <span>ESC per chiudere</span>
                  <button
                    className="underline underline-offset-2 hover:opacity-100"
                    onClick={() =>
                      setMessages([
                        {
                          role: "assistant",
                          content:
                            "Reset fatto. Dimmi: piattaforma, obiettivo, budget, paese, pubblico e KPI.",
                        },
                      ])
                    }
                  >
                    Reset
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
