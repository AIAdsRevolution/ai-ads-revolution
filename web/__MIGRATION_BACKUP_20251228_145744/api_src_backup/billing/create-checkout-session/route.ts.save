import Stripe from "stripe"
const stripeSecret = process.env.STRIPE_SECRET_KEY;
const basicPriceId = process.env.STRIPE_BASIC_PRICE_ID;

export async function POST() {
  if (!stripeSecret || !basicPriceId) {
    console.error("Stripe non configurato:", {
      hasSecret: !!stripeSecret,
      hasPrice: !!basicPriceId,
    });

    return NextResponse.json(
      {
        error: "Stripe non è configurato correttamente. Contatta il 
supporto o riprova più tardi.",
      },
      { status: 500 }
    );
  }

  try {
    const stripe = new Stripe(stripeSecret);

    const session = await stripe.checkout.sessions.create({
      mode: "subscription",
      line_items: [
        {
          price: basicPriceId,
          quantity: 1,
        },
      ],
      success_url: `${
        process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000"
      }/?checkout=success`,
      cancel_url: `${
        process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000"
      }/?checkout=cancel`,
    });

    return NextResponse.json({ url: session.url });
  } catch (error) {
    console.error("Errore Stripe create-checkout-session:", error);
    return NextResponse.json(
      { error: "Errore durante la creazione della sessione di pagamento 
Stripe." },
      { status: 500 }
    );
  }
}

