"use client";
import React, { useEffect, useRef, useState } from "react";

type Msg = { role: "assistant" | "user"; text: string };

export default function ChatWidget() {
  const [open, setOpen] = useState(false);
  const [input, setInput] = useState("");
  const [messages, setMessages] = useState<Msg[]>([
    {
      role: "assistant",
      text:
        "Ciao 👋 sono l’assistente AI Ads Revolution, disponibile 
24/7.\n\nPosso aiutarti su:\n• Campagne\n• Budget\n• Creatività\n• 
Collegamento Google Ads",
    },
  ]);

  const boxRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    boxRef.current?.scrollTo({
      top: boxRef.current.scrollHeight,
      behavior: "smooth",
    });
  }, [messages, open]);

  function send() {
    const t = input.trim();
    if (!t) return;
    setInput("");
    setMessages((m) => [...m, { role: "user", text: t }]);

    let reply =
      t.toLowerCase().includes("google") || 
t.toLowerCase().includes("ads")
        ? "🔗 Per collegare Google Ads servono Developer Token, OAuth e 
Refresh Token. Quando vuoi lo facciamo insieme."
        : t.toLowerCase().includes("budget")
        ? "💰 Posso aiutarti a impostare regole automatiche di budget 
(ROAS, CPA, scaling). Dimmi obiettivo e budget."
        : t.toLowerCase().includes("creativ")
        ? "🎨 Posso generare varianti creative e A/B test. Dimmi settore, 
offerta e target."
        : "Perfetto 👍 dimmi di cosa hai bisogno e ti guido passo passo.";

    setTimeout(() => {
      setMessages((m) => [...m, { role: "assistant", text: reply }]);
    }, 600);
  }

  return (
    <>
      {/* Floating Button */}
      {!open && (
        <button
          onClick={() => setOpen(true)}
          style={{
            position: "fixed",
            right: 22,
            bottom: 22,
            width: 64,
            height: 64,
            borderRadius: 999,
            background: "linear-gradient(135deg,#2d6cff,#7b61ff)",
            border: "none",
            color: "#fff",
            fontWeight: 800,
            cursor: "pointer",
            zIndex: 99999,
            boxShadow: "0 18px 50px rgba(0,0,0,.5)",
          }}
        >
          AI
        </button>
      )}

      {/* Chat Panel */}
      {open && (
        <div
          style={{
            position: "fixed",
            right: 18,
            bottom: 18,
            width: 380,
            height: 520,
            background: "rgba(18,22,30,.95)",
            borderRadius: 16,
            border: "1px solid rgba(255,255,255,.15)",
            zIndex: 99999,
            display: "flex",
            flexDirection: "column",
          }}
        >
          {/* Header */}
          <div
            style={{
              padding: 12,
              borderBottom: "1px solid rgba(255,255,255,.15)",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              color: "#fff",
            }}
          >
            <strong>Assistente AI</strong>
            <button onClick={() => setOpen(false)} style={{ color: "#fff" 
}}>
              ✕
            </button>
          </div>

          {/* Messages */}
          <div
            ref={boxRef}
            style={{
              flex: 1,
              padding: 12,
              overflowY: "auto",
              color: "#fff",
              fontSize: 14,
            }}
          >
            {messages.map((m, i) => (
              <div
                key={i}
                style={{
                  marginBottom: 10,
                  textAlign: m.role === "user" ? "right" : "left",
                }}
              >
                <span
                  style={{
                    display: "inline-block",
                    padding: "8px 12px",
                    borderRadius: 12,
                    background:
                      m.role === "user"
                        ? "linear-gradient(135deg,#2d6cff,#7b61ff)"
                        : "rgba(255,255,255,.08)",
                  }}
                >
                  {m.text}
                </span>
              </div>
            ))}
          </div>

          {/* Input */}
          <div
            style={{
              padding: 10,
              borderTop: "1px solid rgba(255,255,255,.15)",
              display: "flex",
              gap: 8,
            }}
          >
            <input
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={(e) => e.key === "Enter" && send()}
              placeholder="Scrivi un messaggio…"
              style={{
                flex: 1,
                background: "rgba(255,255,255,.08)",
                border: "none",
                borderRadius: 8,
                padding: 8,
                color: "#fff",
              }}
            />
            <button onClick={send} style={{ color: "#fff" }}>
              ➤
            </button>
          </div>
        </div>
      )}
    </>
  );
}

