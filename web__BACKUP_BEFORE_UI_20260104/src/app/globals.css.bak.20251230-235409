@tailwind base;
@tailwind components;
@tailwind utilities;

/* AI Ads Revolution — Brand System V1 (NO @apply) */
:root{
  --bg0:#070A12;
  --bg1:#0B1020;

  --panel:rgba(255,255,255,.06);
  --stroke:rgba(255,255,255,.10);

  --text:#F8FAFC;
  --muted:#A8B2C3;

  --ai:#4F46E5;
  --glow:#22D3EE;

  --ok:#34D399;
}

html,body{
  background:
    radial-gradient(1200px 800px at 20% 0%, rgba(79,70,229,.18), transparent 55%),
    radial-gradient(900px 700px at 80% 10%, rgba(34,211,238,.14), transparent 55%),
    linear-gradient(180deg, var(--bg0), var(--bg1));
  color: var(--text);
}

a{ color: inherit; text-decoration: none; }
a:hover{ opacity: .95; }

/* UI helpers (pure CSS, stable) */
.ui-container{
  margin-left:auto;
  margin-right:auto;
  width:100%;
  max-width:72rem;      /* = max-w-6xl */
  padding-left:1.25rem; /* = px-5 */
  padding-right:1.25rem;
}

.ui-card{
  background: var(--panel);
  border: 1px solid var(--stroke);
  border-radius: 18px;
  box-shadow: 0 10px 26px rgba(0,0,0,.40);
  backdrop-filter: blur(10px);
}

.ui-chip{
  display:inline-flex;
  align-items:center;
  gap:.5rem;
  border-radius:9999px;
  padding:.25rem .75rem;
  font-size:12px;
  border:1px solid var(--stroke);
  background: rgba(255,255,255,.05);
  color: var(--muted);
}

.ui-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:14px;
  padding:.75rem 1.25rem;
  font-weight:600;
  transition: all 180ms ease;
}

.ui-btn-primary{
  background: linear-gradient(135deg, var(--ai), rgba(79,70,229,.72));
  color: var(--text);
  box-shadow: 0 0 0 1px rgba(79,70,229,.35), 0 18px 40px rgba(79,70,229,.22);
}
.ui-btn-primary:hover{ filter: brightness(1.07); transform: translateY(-1px); }

.ui-btn-ghost{
  background: rgba(255,255,255,.06);
  border: 1px solid var(--stroke);
  color: var(--text);
}
.ui-btn-ghost:hover{ background: rgba(255,255,255,.10); transform: translateY(-1px); }

.ui-grid{
  background-image:
    linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
  background-size:44px 44px;
  -webkit-mask-image: radial-gradient(closest-side, rgba(0,0,0,1), rgba(0,0,0,0));
  mask-image: radial-gradient(closest-side, rgba(0,0,0,1), rgba(0,0,0,0));
}

.ui-hero-glow{
  position:absolute;
  inset:-35%;
  background:
    radial-gradient(circle at 30% 20%, rgba(79,70,229,.35), transparent 40%),
    radial-gradient(circle at 80% 35%, rgba(34,211,238,.22), transparent 45%);
  filter: blur(18px);
  pointer-events:none;
}
